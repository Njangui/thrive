# ============================================================
# CRESYVA — Variables d'environnement
# Copier en .env.local et remplir. Ne JAMAIS commit .env.local.
# Toutes les clés secrètes restent côté serveur (jamais NEXT_PUBLIC_*).
# ============================================================

# --- Supabase (Phase 1) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Domaine racine pour le routing multi-tenant par sous-domaine (section 23)
# ex: scholarmach.com -> tenant.scholarmach.com
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# --- Zernio (Messaging Provider principal V1, section 7) ---
ZERNIO_API_KEY=
ZERNIO_API_BASE_URL=https://zernio.com/api/v1
# Secret utilisé pour vérifier la signature des webhooks entrants
ZERNIO_WEBHOOK_SIGNING_SECRET=

# YouTube natif (Google OAuth)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_STATE_SECRET=

# --- AI Gateway (section 8) — un seul provider actif en V1, les autres
# adapters existent mais ne sont pas nécessairement appelés ---
AI_PROVIDER_DEFAULT=mistral
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Payment Provider (section 29 / Lot G, migré NotchPay -> Fapshi le
# 2026-09-20) — Fapshi est le seul adapter réellement implémenté
# (paiement d'abonnement + add-ons + numéro dédié), voir
# docs/PAYMENT_INTEGRATION.md. CinetPay reste au schéma pour une future
# intégration mais n'a aucun adapter branché — PAYMENT_PROVIDER_DEFAULT
# à "cinetpay" ferait échouer getPaymentProvider() volontairement.
# Fapshi ne traite QUE le XAF (Cameroun, MTN MoMo/Orange Money) — voir
# le commentaire de getPaymentProvider() dans registry.ts.
PAYMENT_PROVIDER_DEFAULT=fapshi
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Fapshi authentifie avec DEUX valeurs (dashboard Fapshi > Developers) —
# contrairement à NotchPay qui n'en exigeait qu'une.
FAPSHI_API_USER=
FAPSHI_API_KEY=
# Secret webhook — simple secret partagé (PAS un HMAC comme NotchPay),
# configuré une seule fois côté dashboard Fapshi (Developers > Webhooks)
# et jamais relisible ensuite : notez-le en le créant.
FAPSHI_WEBHOOK_SECRET=
# sandbox.fapshi.com pour les tests (numéros de test documentés par
# Fapshi), live.fapshi.com en production — valeur par défaut si absent.
FAPSHI_BASE_URL=https://live.fapshi.com

# --- Domain Registrar (Lot N, Partie 2) — optionnel, repli automatique
# sur ManualDomainAdapter en leur absence. Compte reseller UNIQUE pour
# toute la plateforme (comme NotchPay), jamais par tenant.
OPENPROVIDER_USERNAME=
OPENPROVIDER_PASSWORD=

# --- Feature flags globaux (ne pas hardcoder de logique métier ici,
# ceci ne fait qu'activer/désactiver des sous-systèmes non-tenant) ---
ENABLE_AI_INSIGHTS=true
ENABLE_AUTOMATION_ENGINE=false

# --- Cron interne (Lot F : traitement des diffusions groupées WhatsApp
# programmées) — voir docs/DEPLOYMENT.md, section "Diffusions groupées
# WhatsApp". Protège /api/cron/* : sans cette valeur, la route reste
# accessible sans authentification (avertissement au démarrage).
CRON_SECRET=

# --- Web Push (Lot I, Partie 1) — optionnel : générer avec
# `npx web-push generate-vapid-keys`. Tant que ces clés sont vides, le
# toggle "notifications push" reste masqué et sendPush() ne fait rien. ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@scholarmach.com

# --- Email (Lot L, Partie 1 — invitations d'équipe). Optionnel : sans
# clé, les invitations sont créées normalement (le lien reste valable et
# affiché dans le dashboard) mais l'email lui-même n'est que loggé côté
# serveur — voir docs/EMAIL_INTEGRATION.md. ---
RESEND_API_KEY=
# IMPORTANT : tant qu'aucun domaine n'est vérifié dans le compte Resend
# (resend.com/domains), seule l'adresse *@resend.dev fonctionne, et
# UNIQUEMENT en envoyant vers l'email du titulaire du compte Resend —
# jamais vers un vrai destinataire d'invitation. Remplacer par une
# adresse sur un domaine vérifié avant la mise en production.
EMAIL_FROM_ADDRESS=CRESYVA <onboarding@resend.dev>

# --- Rate limiting (proposition d'amélioration post-vague master prompt).
# Optionnel : sans ces deux variables, le rate limiting est silencieusement
# désactivé (un avertissement est loggé une fois) — jamais un crash. Créer
# une base Upstash Redis gratuite sur upstash.com pour les obtenir. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Programme d'affiliation (0044_affiliate_system.sql). Voir
# docs/AFFILIATE_SYSTEM.md. Secret de signature HMAC des jetons de cookie
# d'attribution (/r/[code]) ET pepper de hachage IP/user-agent anti-fraude
# — GÉNÉRER une valeur aléatoire longue (ex: `openssl rand -hex 32`),
# jamais réutiliser un autre secret du projet. Tant qu'absent, /r/[code]
# répond une erreur explicite plutôt que de signer avec un secret vide. ---
AFFILIATE_LINK_SECRET=

# --- Telegram — DEUX intégrations INDÉPENDANTES l'une de l'autre et de
# Zernio, voir docs/TELEGRAM_INTEGRATION.md :
#
# 1) Bot PLATEFORME (alertes admin + commandes affiliés /mystats) — un
#    seul bot pour toute la plateforme, créé une fois via @BotFather.
# 2) Canal CLIENT par tenant (infrastructure/providers/messaging/telegram/*)
#    — chaque organisation connecte SON PROPRE bot depuis
#    /dashboard/channels, aucune variable d'environnement globale
#    nécessaire pour ce second usage (jeton stocké en Vault par tenant).
#
# Toutes optionnelles : en leur absence, le bot plateforme reste désactivé
# (repli sur un adapter "console log" pour les alertes admin) sans jamais
# faire échouer le reste de l'application. ---
TELEGRAM_BOT_TOKEN=
# Valeur arbitraire choisie par vous à l'enregistrement du webhook
# (`setWebhook`, voir docs/TELEGRAM_INTEGRATION.md) — PAS un HMAC, Telegram
# la renvoie telle quelle dans un header à chaque delivery.
TELEGRAM_BOT_WEBHOOK_SECRET=
# Sans le @ (ex: "smeos_partenaires_bot") — sert à construire les liens de
# liaison profonds affichés sur /affiliate/dashboard/telegram.
TELEGRAM_BOT_USERNAME=
# Chat/groupe Telegram recevant les alertes opérateur (nouvelle
# candidature affilié, fraude détectée, demande de paiement).
TELEGRAM_ADMIN_CHAT_ID=
